# Copy to .env and fill in — user supplies their own key, never hardcoded.
# At least one of these is required; which ones depends on which LLM(s)
# the deployed app is configured to call.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Only needed once Phase 2 adds Firecrawl-scraped sources (Solutions
# Library, case studies) — not required to run the deployed app.
# FIRECRAWL_API_KEY=
